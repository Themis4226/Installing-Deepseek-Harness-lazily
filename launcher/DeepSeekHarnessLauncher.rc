#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "deepseek-app-rounded.ico"
IDR_UPDATER_SCRIPT RCDATA "updater.mjs"
IDR_LAUNCHER_INTEGRATION_PATCH RCDATA "..\\launcher-integration\\cordis.patch.yml"
IDR_LAUNCHER_INTEGRATION_PACKAGE RCDATA "..\\launcher-integration\\dsh-launcher-update-ui\\package.json"
IDR_LAUNCHER_INTEGRATION_INDEX RCDATA "..\\launcher-integration\\dsh-launcher-update-ui\\lib\\index.js"
IDR_LAUNCHER_INTEGRATION_CLIENT RCDATA "..\\launcher-integration\\dsh-launcher-update-ui\\lib\\client.js"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,2,0
 PRODUCTVERSION 1,4,2,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Local desktop launcher\0"
            VALUE "FileDescription", "Unofficial desktop launcher for DeepSeek Harness\0"
            VALUE "FileVersion", "1.4.2.0\0"
            VALUE "InternalName", "DeepSeekHarnessLauncher\0"
            VALUE "LegalCopyright", "DeepSeek mobile app icon copyright Hangzhou DeepSeek Artificial Intelligence Co., Ltd.\0"
            VALUE "OriginalFilename", "DeepSeek Harness.exe\0"
            VALUE "ProductName", "DeepSeek Harness Desktop Launcher\0"
            VALUE "ProductVersion", "1.4.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
